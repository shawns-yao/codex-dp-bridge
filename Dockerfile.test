# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22.19-bookworm
FROM ${NODE_IMAGE}

RUN if command -v git >/dev/null 2>&1 && command -v ps >/dev/null 2>&1; then \
      true; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache git; \
    else \
      echo "基础镜像缺少 git 或 ps" >&2; exit 1; \
    fi

WORKDIR /workspace/codex-dp

COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts

COPY . .

ENV CODEX_DP_HOME=/tmp/codex-dp-state
ENV CODEX_DP_BIN_DIR=/tmp/codex-dp-bin

RUN npm run check \
 && npm run build \
 && npm test \
 && npm pack --dry-run --ignore-scripts

CMD ["node", "dist/src/cli.js", "setup", "preview"]
