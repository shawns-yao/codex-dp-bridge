# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22.19-bookworm-slim
FROM ${NODE_IMAGE}

RUN if command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends git procps ca-certificates && rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache git procps ca-certificates; \
    else \
      echo "不支持的 Linux 基础镜像" >&2; exit 1; \
    fi

WORKDIR /workspace/codex-dp

COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts

COPY . .

ENV CODEX_DP_HOME=/tmp/codex-dp-state
ENV CODEX_DP_BIN_DIR=/tmp/codex-dp-bin

RUN npm run check \
 && npm run build \
 && npm test \
 && npm pack --dry-run --ignore-scripts

CMD ["node", "dist/src/cli.js", "setup", "preview"]
